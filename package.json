{
  "name": "onmyoji-support-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first Android emulator support tools",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "frontend:dev": "vite",
    "frontend:build": "vue-tsc --noEmit && vite build",
    "build": "pnpm build:windows:x64",
    "build:windows": "pnpm build:windows:x64",
    "build:windows:x64": "node scripts/build-windows.mjs --architecture x64",
    "build:windows:arm64": "node scripts/build-windows.mjs --architecture arm64",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test scripts/build-windows.node-test.mjs && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@lucide/vue": "1.35.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  }
}
