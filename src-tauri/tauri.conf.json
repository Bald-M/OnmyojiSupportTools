{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnmyojiSupportTools",
  "version": "0.1.0",
  "identifier": "io.github.baldm.onmyojisupporttools",
  "build": {
    "beforeDevCommand": "pnpm frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnmyojiSupportTools",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
